<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B14"
    tools:context=".MainActivity">


    <!--
            Fondo animado nativo.
            Va como primer hijo del ConstraintLayout para quedar detrás de todo el contenido.
            La clase está en:
            app/src/main/java/com/oraculo/app/ui/views/NightChatBackgroundView.kt

            Importante:
            - No recibe clicks.
            - No reemplaza tu UI.
            - Solo dibuja el fondo.
        -->
    <com.oraculo.app.ui.views.NightChatBackgroundView
        android:id="@+id/nightChatBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="visible"
        tools:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Contenedor principal de tu interfaz.
        Este bloque queda por encima del fondo animado.
    -->

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


    <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ORACLE"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cliente Android conectado al backend IA RAG"
            android:textColor="#8FA4D4"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textBackendStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Backend: comprobando conexión..."
            android:textColor="#EAF2FF"
            android:textSize="15sp"
            android:layout_marginTop="28dp" />

        <EditText
            android:id="@+id/editQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#57A6FF"
            android:hint="Escribe tu pregunta"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="56dp"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8190B5" />


        <!--
           Botón principal glass con borde RGB.

           Puntos clave:
           - android:background usa nuestro drawable personalizado.
           - android:backgroundTint="@null" evita que el tema pinte encima del drawable.
           - app:backgroundTint="@null" refuerza lo mismo para AppCompat.
           - android:elevation agrega sombra real.
           - stateListAnimator="@null" evita cambios raros de elevación al tocar.
       -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonAsk"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_glass_rgb"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:elevation="12dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@null"
            android:text="Enviar pregunta"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!--
     Indicador de carga.

     Usamos android:indeterminateDrawable="@drawable/progress_oracle_static"
     para evitar un error del Preview de Android Studio con el drawable animado
     por defecto del ProgressBar.
 -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/progress_oracle_static"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pregunta: todavía no se ha enviado ninguna consulta."
            android:textColor="#C9D4F5"
            android:textSize="15sp"
            android:layout_marginTop="22dp" />

        <TextView
            android:id="@+id/textAnswerLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Respuesta:"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp" />

        <ScrollView
            android:id="@+id/scrollAnswer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/textAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="La respuesta aparecerá aquí."
                android:textColor="#DDE6FF"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp" />

        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>