<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B14"
    android:animateLayoutChanges="true">

    <!-- Fondo animado ya existente -->
    <com.oraculo.app.ui.views.NightChatBackgroundView
        android:id="@+id/nightChatBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenedor principal del contenido -->
    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/composerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Título -->
        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ORACLE"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cliente Android conectado al backend IA"
            android:textColor="#9BB0D7"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <!-- Estado del backend -->
        <TextView
            android:id="@+id/textBackendStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Backend: comprobando conexión..."
            android:textColor="#EAF2FF"
            android:textSize="15sp"
            android:layout_marginTop="24dp" />

        <!-- Pregunta mostrada -->
        <TextView
            android:id="@+id/textQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pregunta: todavía no se ha enviado ninguna consulta."
            android:textColor="#C9D4F5"
            android:textSize="15sp"
            android:layout_marginTop="18dp" />

        <!-- Etiqueta de respuesta -->
        <TextView
            android:id="@+id/textAnswerLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Respuesta:"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp" />

        <!-- Scroll de respuesta -->
        <ScrollView
            android:id="@+id/scrollAnswer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:fillViewport="true">

            <TextView
                android:id="@+id/textAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="La respuesta aparecerá aquí."
                android:textColor="#DDE6FF"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp" />
        </ScrollView>

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/progress_oracle_static"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Barra inferior de mensaje
    Contenedor fijo inferior que agrupa input + botón.
     minHeight asegura área táctil cómoda. -->

    <LinearLayout
        android:id="@+id/composerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_message_composer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Campo de texto y hacer que el campo crezca al escribir

        Mantiene el mismo id editQuestion para no romper MainActivity.
        Crece según el texto hasta 10 líneas.
        minHeight de 48dp para evitar warning de touch target. -->

        <EditText
            android:id="@+id/editQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="@android:color/transparent"
            android:gravity="top|start"
            android:hint="El destino tiene un precio por ser visto..."
            android:imeOptions="actionSend|flagNoExtractUi"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="10"
            android:minLines="1"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:scrollbars="vertical"
            android:textColor="#FFFFFF"
            android:textColorHint="#7F8DAE" />



        <!-- Botón enviar
             Mantiene el mismo id buttonAsk para no romper MainActivity.
             Se aumenta altura mínima a 48dp para cumplir accesibilidad táctil.
        -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonAsk"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:background="@drawable/bg_button_glass_rgb"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="⪢"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>