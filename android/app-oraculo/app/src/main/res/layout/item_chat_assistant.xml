<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="48dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/textAssistantMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_assistant"
        android:lineSpacingExtra="4dp"
        android:maxWidth="300dp"
        android:text="Respuesta de ORACLE"
        android:textColor="#DDE6FF"
        android:textSize="15sp" />

    <!-- Acciones de respuesta: aparecerán funcionales cuando el mensaje esté completo -->
    <LinearLayout
        android:id="@+id/assistantActionsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/buttonCopyAssistantMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_action_button"
            android:clickable="true"
            android:focusable="true"
            android:text="❐"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/buttonLikeAssistantMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chat_action_button"
            android:clickable="true"
            android:focusable="true"
            android:text="👍"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/buttonDislikeAssistantMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chat_action_button"
            android:clickable="true"
            android:focusable="true"
            android:text="👎"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/textAssistantSources"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:text="Fuentes:\n• Unidad 2: Unidades funcionales de un ordenador"
        android:textColor="#9BB0D7"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>