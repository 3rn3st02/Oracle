<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de la barra inferior de envío -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fondo semitransparente oscuro -->
    <solid android:color="#AA10182A" />

    <!-- Bordes redondeados -->
    <corners android:radius="22dp" />

    <!-- Borde suave -->
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />

    <!-- Padding interno -->
    <padding
        android:left="10dp"
        android:top="8dp"
        android:right="10dp"
        android:bottom="8dp" />
</shape>