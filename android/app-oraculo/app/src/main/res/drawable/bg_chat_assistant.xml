<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Sombra exterior suave para la IA.

        Versión mate:
        - discreta
        - no brillante
        - no invade el texto
    -->
    <item
        android:right="1dp"
        android:top="2dp">

        <shape android:shape="rectangle">

            <!--
                Sombra oscura suave.
            -->
            <solid android:color="#22000000" />

            <!--
                Bordes más amplios para dar aire visual.
            -->
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp"
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="22dp" />

        </shape>
    </item>

    <!--
        Capa base glass mate de la IA.

        Se mantiene la opacidad:
        #80 = 50%

        No cambiamos la translucidez.
    -->
    <item>

        <shape android:shape="rectangle">

            <!--
                Fondo principal translúcido de la IA.
                Mantiene 50% de opacidad.
            -->
            <solid android:color="#80141A2A" />

            <!--
                Borde frío mate.

                Más suave que el anterior para que no parezca neón.
            -->
            <stroke
                android:width="1dp"
                android:color="#66BBD6FF" />

            <!--
                Bordes más redondeados y amplios.
            -->
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp"
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="22dp" />

        </shape>
    </item>

    <!--
        Brillo superior mate.

        Reflejo más suave para evitar aspecto demasiado brillante.
    -->
    <item>

        <shape android:shape="rectangle">

            <!--
                Reflejo superior tenue.
            -->
            <gradient
                android:angle="270"
                android:startColor="#1EFFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF" />

            <!--
                Misma forma completa.
            -->
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp"
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="22dp" />

        </shape>
    </item>

    <!--
        Oscurecimiento inferior muy sutil.

        Aporta volumen sin endurecer el glass.
    -->
    <item>

        <shape android:shape="rectangle">

            <!--
                Sombra interna reducida.
            -->
            <gradient
                android:angle="90"
                android:startColor="#16000000"
                android:centerColor="#00000000"
                android:endColor="#00000000" />

            <!--
                Misma forma completa.
            -->
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp"
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="22dp" />

        </shape>
    </item>

</layer-list>